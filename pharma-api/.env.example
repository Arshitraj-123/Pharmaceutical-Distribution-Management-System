# ==============================================================================
# Aadya Pharma Distribution API - Environment Configuration Template
# ==============================================================================
# Use these environment variables when configuring your Node.js application in 
# Hostinger (hPanel -> Node.js -> Environment Variables) or in a server .env file.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
# Note: Ensure 0.0.0.0/0 is whitelisted in MongoDB Atlas Network Access.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/pharma?retryWrites=true&w=majority

# JWT Authentication Secret
# Generate a strong 32+ character random string for production
JWT_SECRET=your_super_secret_jwt_key_for_production_2026

# CORS Frontend Origins
# Specify the domains where your Hostinger frontends are hosted.
# You can use commas to separate multiple domains in FRONTEND_URL, or set individual URLs below.
FRONTEND_URL=https://your-retailer-domain.com,https://your-admin-domain.com
ADMIN_URL=https://your-admin-domain.com
RETAILER_URL=https://your-retailer-domain.com
# ALLOWED_ORIGINS=https://custom-domain.com

# 2FA / Authentication Demo Mode
# Set to 'false' for strict production OTP behavior.
# Set to 'true' to allow default test OTP (1234) and include OTP in response for console testing.
DEMO_MODE=true

# Password Reset Safety Flag
# Set to 'true' if you ever need to reset default admin/retailer passwords back to 'Password123!'.
# Default is 'false' to ensure modified production passwords are NOT wiped on server reboots.
RESET_DEFAULT_USERS=false

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Hostinger Business Email SMTP (for 2-Step OTPs & Invoices)
# Use your Hostinger hPanel Business Email credentials:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=orders@aadyamedicineagencies.com
SMTP_PASS=your_hostinger_email_password
SMTP_FROM=orders@aadyamedicineagencies.com

